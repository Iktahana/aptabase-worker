{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "aptabase_events_v1_staging"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INGESTION_GUARD",
        "class_name": "IngestionGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-guard",
      "new_sqlite_classes": ["IngestionGuard"]
    }
  ],
  "keep_vars": true
}
